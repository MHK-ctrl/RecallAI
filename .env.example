# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------
# PostgreSQL 15+ with the pgvector extension.
DATABASE_URL=postgres://postgres@127.0.0.1:5433/recallai
# 32+ random characters, used to sign short-lived file URLs.
# Generate with: openssl rand -hex 32
SESSION_SECRET=

# Public base URL of the deployment (used in reset links and metadata).
APP_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Optional AI providers (OpenAI-compatible APIs)
# ---------------------------------------------------------------------------
# Chat model used for grounded answers. Leave empty for extractive mode.
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=

# Embedding model for semantic retrieval. If empty, RecallAI uses a local
# lexical hashing vector and hybrid keyword search.
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
# Must match the vector(1536) column in db/migrations/001_init.sql.
EMBEDDING_DIM=1536

# ---------------------------------------------------------------------------
# Limits
# ---------------------------------------------------------------------------
# Vercel serverless functions cap request bodies at 4.5 MB.
MAX_UPLOAD_MB=8
MAX_CHUNKS_PER_DOCUMENT=400
USER_STORAGE_QUOTA_MB=250
OCR_ENABLED=true
